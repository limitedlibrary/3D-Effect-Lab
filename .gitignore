# --- 秘密情報（念のため） ---
.env
.env.*
*.pem
*.key
secrets*.json

# --- 生成物・配布用アーカイブ ---
# app/ から作り直せる配布用 zip
*.zip
# Blender の生成ファイル（lab_to_blender.py で JSON から作り直せる）
*.blend
*.blend1
*.blend2
# ラボの「⇪ Blenderへ出力」で作るフレームごとのアニメーション JSON
# （検証レポート verify_report.json は小さいので残す）
blender-check/*_[0-9]*fps.json
exports/

# --- Python ---
__pycache__/
*.py[cod]

# --- OS / エディタ ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
